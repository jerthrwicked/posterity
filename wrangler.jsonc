{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "posterity",
  // worker.js passes the site through and adds the dispatch scheduler's cycle.
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // www is the site. The bare domain is not attached here: a Cloudflare redirect
  // rule sends yourposterity.com to www, as Vercel did. Cut over 2026-10-11.
  "routes": [
    { "pattern": "www.yourposterity.com", "custom_domain": true }
  ],
  "workers_dev": false,
  // Wakes the Communication Dispatch System's scheduler every minute (worker.js).
  "triggers": { "crons": ["* * * * *"] }
}
