#!/usr/bin/env bash
# Posterity — the Build Log reminder · Walker Brown
# If you changed the app or the database, the Build Log gets an entry.
#
# The record is the Google Doc "Posterity Build Roadmap (Draft) — October 26"
# (1gwcdTcveNo7nlFlA473sATKKDHF_-vpfg4cUNICsDlc), and a hook cannot see it, so
# this reminds rather than blocks. The entry is written once the build item's
# code reaches main, naming the commit that built it.
set -euo pipefail

STAGED="$(git diff --cached --name-only)"
SUBSTANTIVE="$(printf '%s\n' "$STAGED" | grep -E '^(app/|lib/|proxy\.js$|supabase/migrations/|scripts/)' || true)"
[ -n "$SUBSTANTIVE" ] || exit 0

cat >&2 <<'MSG'

  Reminder: this commit changes code or the database. When it reaches main, add
  it to the Build Log in the roadmap Doc and remove the item from its stage, in
  the same pass. Mark DATABASE changes separately: they are already live.

MSG
exit 0
